{
  "name": "felix-personal-website",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "bun scripts/build-with-timeout.ts && bun scripts/check-prerender.ts && bun scripts/check-anti-ai.ts",
    "build:direct": "vite build",
    "build:check": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "images": "bun scripts/optimize-images.ts",
    "blog:split": "bun scripts/split-blog.ts",
    "transform-data": "bun scripts/transform-data-optimized.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "check:prerender": "bun scripts/check-prerender.ts",
    "check:anti-ai": "bun scripts/check-anti-ai.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-ga4": "^2.1.0",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^16.5.0",
    "oxc-transform-react": "^0.148.0",
    "prettier": "^3.8.3",
    "sharp": "^0.35.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-prerender-plugin": "^0.5.13"
  },
  "overrides": {
    "minimatch": "^9.0.6",
    "brace-expansion": "^1.1.13",
    "flatted": "^3.4.0",
    "glob": "^10.5.0"
  }
}
